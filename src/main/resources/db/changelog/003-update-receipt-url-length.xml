<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="007-increase-receipt-url-length" author="secretweapon">
        <comment>Increase the length of receipt_url column in expense_item table to 1000 chars.</comment>

        <modifyDataType
                tableName="expense_item"
                columnName="receipt_url"
                newDataType="VARCHAR(1000)"/>

    </changeSet>

</databaseChangeLog>
